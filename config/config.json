{
  "models": {
    "chat": "qwen3:8b",
    "agent": "qwen3:8b",
    "fast": "gemma2b",
    "vision": "gemma-vision-1"
  },
  "ollama": {
    "host": "http://localhost:11434",
    "timeout": 60,
    "stream": true
  },
  "paths": {
    "memory_db": "data/yuna.db",
    "logs": "logs/",
    "data_folder": "data/",
    "memory_txt_legacy": "~/yuna/memoria.txt"
  },
  "permissions": {
    "interactive": true,
    "confirmations": true
  },
  "voice": {
    "enabled": true,
    "voice": "es-MX-DaliaNeural",
    "max_chars": 300
  },
  "agent": {
    "max_iterations": 5,
    "temperature_plan": 0.2,
    "temperature_execute": 0.4,
    "context_window": 2048
  }
}
